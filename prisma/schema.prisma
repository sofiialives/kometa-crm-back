generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  lead
  staff
}

enum UserStatus {
  invited
  active
}

enum WorkStatus {
  active
  done
  archived
}

enum TaskStatus {
  today
  progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskOrigin {
  personal
  hierarchy
}

// Клиент на Доске: либо с нами работает, либо ушёл. Это текущее состояние,
// а не вычисление по выбранному месяцу: заказчик прямо сказал, что клиент
// без платежа в месяце «уже будет во вкладке ушёл висеть».
enum BoardClientStatus {
  active
  left
}

model User {
  id               String      @id @default(cuid())
  name             String      @default("")
  email            String      @unique
  passwordHash     String?
  googleId         String?
  avatarUrl        String?
  avatarColor      String?
  role             Role        @default(staff)
  position         String?

  departmentId     String?
  department       Department? @relation("DepartmentUsers", fields: [departmentId], references: [id])

  status           UserStatus  @default(invited)
  active           Boolean     @default(true)

  resetCodeHash    String?
  resetCodeExpires DateTime?

  leadOf           Department? @relation("DepartmentLead")
  createdWorks     Work[]      @relation("WorkCreatedBy")
  assignedWorks    Work[]      @relation("WorkAssignees")
  tasks            Task[]      @relation("TaskOwner")
  calls            Call[]      @relation("CallOwner")
  callsJoined      Call[]      @relation("CallParticipants")
  telegram         TelegramLink?

  boardClients     BoardClient[]    @relation("BoardClientAddedBy")
  archiveClients   ArchiveClient[]  @relation("ArchiveClientAddedBy")
  archiveServices  ArchiveService[] @relation("ArchiveServiceCreatedBy")
  archiveReports   ArchiveReport[]  @relation("ArchiveReportAuthor")
  taskStat         UserTaskStat?

  // Мотивация. Банк и баллы есть у сотрудников и руководителей, а владелец
  // оставляет следы в журналах: кто пополнил, кто отменил, кто назначил
  // профиль. Поэтому связей несколько.
  motivationAssignments     MotivationAssignment[] @relation("MotivationAssignmentUser")
  motivationAssignmentsMade MotivationAssignment[] @relation("MotivationAssignmentCreatedBy")
  motivationBankEntries     MotivationBankEntry[]  @relation("MotivationBankEntryUser")
  motivationBankEntriesMade MotivationBankEntry[]  @relation("MotivationBankEntryCreatedBy")
  motivationEvents          MotivationEvent[]      @relation("MotivationEventUser")
  motivationEventsMade      MotivationEvent[]      @relation("MotivationEventCreatedBy")
  motivationEventsCancelled MotivationEvent[]      @relation("MotivationEventCancelledBy")
  motivationSeen            MotivationSeen?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([departmentId])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  positions String[] @default([])

  leadId    String?  @unique
  lead      User?    @relation("DepartmentLead", fields: [leadId], references: [id])

  users     User[]   @relation("DepartmentUsers")
  works     Work[]
  tasks     Task[]
  calls     Call[]
  archiveServices ArchiveService[]
  archiveClients  ArchiveClient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  works     Work[]

  // Карточка этого клиента в Архиве, если его туда заносили. Связь
  // обязательная со стороны архива и без onDelete, то есть Restrict:
  // удалить клиента, по которому есть архив, база не даст. Это сделано
  // специально — архив переживает операционные данные, ради этого он и
  // существует. Понятное сообщение вместо ошибки базы даёт client.service.js.
  // Записей может быть несколько — по одной на отдел, который вёл клиента.
  archive   ArchiveClient[]

  // Карточка этого клиента на Доске клиентов, если его туда заносили.
  // Связь без onDelete, то есть Restrict: удалить клиента, по которому
  // ведётся финансовый учёт, база не даст.
  board     BoardClient?

  // Пополнения банка «за нового клиента» и отметки «клиент купил продукт».
  // Связь необязательная и без запрета на удаление: журнал мотивации
  // хранит название клиента у себя, поэтому переживёт и его удаление.
  motivationBankEntries MotivationBankEntry[]
  motivationEvents      MotivationEvent[]
}

model Work {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id])
  title        String

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdById  String
  createdBy    User       @relation("WorkCreatedBy", fields: [createdById], references: [id])
  assignees    User[]     @relation("WorkAssignees")

  status       WorkStatus @default(active)
  tasks        Task[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([clientId])
}

model UserTaskStat {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
  doneCount    Int      @default(0)
  overdueCount Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  deadline     DateTime

  // Во сколько человек садится за задачу. Заказчик просил вписывать это
  // при постановке: по одному дедлайну не видно, занят человек с утра или
  // только собирается начать. Поле необязательное в базе — задачи, которые
  // уже заведены, и те, что приходят из Иерархии, его не имеют.
  startAt      DateTime?

  status       TaskStatus @default(today)
  priority     TaskPriority @default(medium)
  // Проставляется ОДИН РАЗ при создании и больше никогда не меняется —
  // даже когда work.service.js/client.service.js обнуляют workId при
  // удалении работы/клиента (это делается специально, чтобы не терять
  // историю задач). Без этого поля задача из Иерархии после удаления её
  // работы становится неотличима от обычной личной и протекает в
  // Задачник — ровно так и произошло на бою.
  origin       TaskOrigin @default(personal)
  doneAt       DateTime?

  ownerId      String
  owner        User       @relation("TaskOwner", fields: [ownerId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  workId       String?
  work         Work?      @relation(fields: [workId], references: [id])

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ownerId, status])
  @@index([departmentId, status])
}

// Звонок в календаре. Живёт рядом с Task, но намеренно отдельной моделью:
// у звонка нет колонок/статусов доски, а есть только момент времени, и
// смешивать их в одну таблицу значило бы тащить в задачи лишние поля.
//
// Прошедшие звонки удаляет ночная уборка (clearPastCalls.job.js) — по той
// же логике, что и просроченные задачи. Отдельного поля «прошёл» нет
// специально: это не состояние, а сравнение scheduledAt с текущим
// временем, и хранить его значило бы держать в базе то, что протухает
// каждую минуту.
model Call {
  id           String      @id @default(cuid())
  title        String
  note         String?
  scheduledAt  DateTime

  // Организатор. Он в контакте с клиентом, поэтому только он меняет
  // время и состав — участники карточку видят, но не трогают.
  ownerId      String
  owner        User        @relation("CallOwner", fields: [ownerId], references: [id])

  // Остальные, кого позвали на звонок. Карточка одна на всех и
  // показывается в календаре у каждого — как приглашение в календаре.
  participants User[]      @relation("CallParticipants")

  // Берётся от отдела владельца в момент создания — по нему главный видит
  // свой отдел, а админ группирует «Все звонки». У админа отдела нет,
  // поэтому поле необязательное.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ownerId, scheduledAt])
  @@index([departmentId, scheduledAt])
}

// Связка сотрудника с его телеграмом. Нужна боту напоминаний: телеграм
// отдаёт ему только @ник и id чата, а общего признака с CRM у них нет,
// поэтому связь один раз устанавливается через кнопку в настройках.
//
// Как это работает: человек жмёт «Подключить телеграм», CRM кладёт сюда
// одноразовый код, человек открывает по ссылке бота и нажимает Start,
// бот находит строку по коду и вписывает chatId. Подделать нельзя —
// код выдаётся тому, кто уже вошёл в CRM под собой.
//
// Пишет в эту таблицу и CRM (код), и бот (chatId). Это единственное
// место, где бот что-то меняет: во всём остальном он только читает.
model TelegramLink {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Живёт минуты и гаснет после использования, поэтому обнуляемый.
  code          String?   @unique
  codeExpiresAt DateTime?

  chatId        String?
  username      String?
  linkedAt      DateTime?

  updatedAt     DateTime  @updatedAt
}

// ============================================================================
// Архив отчётов по клиентам.
//
// Отчёт здесь — это PDF-файл, а не текст в базе: специалист делает отчёт у
// себя и заливает готовым. Поэтому полей с содержанием нет вовсе, зато есть
// вытащенный из файла текст — только для поиска.
//
// Сам файл лежит в объектном хранилище (Cloudflare R2), в базе только запись
// о нём. Отдаётся файл через наш API с проверкой отдела, а не по прямой
// ссылке из хранилища.
//
// Почему не переиспользовали Work: работы удаляются каскадом вместе с
// клиентом (client.service.js) и живут на доске Иерархии. Архив должен
// переживать удаление рабочих данных и не засорять экраны команды старыми
// записями, которые заносят задним числом.
// ============================================================================

// Клиент, занесённый в архив. Отдельная запись, а не просто группировка по
// услугам: «занести клиента в архив» — это отдельное действие, и клиент
// может лежать в архиве ещё без единой услуги.
model ArchiveClient {
  id        String   @id @default(cuid())

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])

  // Архив у каждого отдела свой: на вкладке отдела должны быть его клиенты,
  // его услуги и его отчёты — и больше ничего. Пока отдела у записи не было,
  // она была одна на клиента, и два отдела дрались за неё: один заносил
  // клиента, у второго тот же клиент либо пропадал из списка, либо не
  // заносился вовсе.
  //
  // Необязательное поле — ради записей, заведённых до этой правки админом,
  // у которого своего отдела нет. Такая запись — пустая заготовка: её видно
  // всем отделам, и первый, кто заведёт в ней услугу, забирает её себе.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  addedById String
  addedBy   User     @relation("ArchiveClientAddedBy", fields: [addedById], references: [id])

  services  ArchiveService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Один клиент может лежать в архиве нескольких отделов, но в своём — один раз.
  @@unique([clientId, departmentId])
  @@index([departmentId])
}

// Услуга, которой занимались для клиента. Название пишут руками каждый раз —
// так решил заказчик, предупреждённый о том, что «Таргет» и «таргетинг»
// станут разными строками.
//
// Отдел живёт здесь, а не на клиенте: одного клиента ведут несколько отделов,
// и карточка клиента показывается во вкладке каждого из них со своими
// услугами.
model ArchiveService {
  id              String        @id @default(cuid())

  archiveClientId String
  archiveClient   ArchiveClient @relation(fields: [archiveClientId], references: [id], onDelete: Cascade)

  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])

  title           String

  createdById     String
  createdBy       User          @relation("ArchiveServiceCreatedBy", fields: [createdById], references: [id])

  reports         ArchiveReport[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([departmentId])
  @@index([archiveClientId])
}

// Сам отчёт. Заголовка нет специально: в списке показывается имя файла,
// как его назвал автор.
model ArchiveReport {
  id          String         @id @default(cuid())

  serviceId   String
  service     ArchiveService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Автор связан без onDelete, то есть Restrict. Сотрудников в CRM и так не
  // удаляют, а деактивируют — но если когда-нибудь начнут, архив обязан
  // помнить, кто это писал.
  authorId    String
  author      User           @relation("ArchiveReportAuthor", fields: [authorId], references: [id])

  // Ключ объекта в хранилище. Уникальный, чтобы одна запись базы не могла
  // указывать на тот же файл, что и другая: удаление одной унесло бы файл
  // у обеих.
  fileKey     String         @unique
  fileName    String
  fileSize    Int

  // Когда работа была сделана. Необязательного тут нет: поле подставляется
  // сегодняшним числом, но его можно поменять — иначе старые отчёты,
  // которые зальют при наполнении архива, все получат дату загрузки и
  // фильтр по периоду окажется бесполезен.
  workedAt    DateTime

  // Текст, вытащенный из PDF при загрузке. Нужен только для поиска и
  // пользователю нигде не показывается. Пусто, если залили скан или
  // картинку — такой отчёт найдётся по клиенту, услуге и дате, но не по
  // словам внутри.
  textContent String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([serviceId, workedAt])
  @@index([authorId])
}

// ============================================================================
// Доска клиентов — финансовый учёт агентства.
//
// Видит её только админ: это выручка, расходы и прибыль всего агентства.
//
// Главное в устройстве: услуга относится к КОНКРЕТНОМУ МЕСЯЦУ, а не к
// клиенту вообще. Заказчик заносит суммы вручную помесячно — «за октябрь
// взяли амбассадорскую программу и ведение телеграм-канала». Без привязки
// к месяцу переключение месяцев на доске ничего бы не меняло, а весь смысл
// доски именно в нём.
//
// Деньги храним в центах целым числом. Доллары с копейками в JavaScript
// складываются с ошибкой, и на суммах агентства это вылезло бы в отчётах.
// ============================================================================

model BoardClient {
  id          String            @id @default(cuid())

  clientId    String            @unique
  client      Client            @relation(fields: [clientId], references: [id])

  // Телефон, телеграм или почта — что укажет руководитель. Одной строкой:
  // разбивать по видам связи незачем, читает её человек.
  contact     String?

  status      BoardClientStatus @default(active)

  // С какого числа клиент у нас. Отдельно от createdAt: клиента заносят на
  // доску задним числом, а «сколько дней с нами» должно считаться от начала
  // работы, а не от момента занесения.
  startedAt   DateTime

  leftAt      DateTime?
  leftReason  String?

  addedById   String
  addedBy     User              @relation("BoardClientAddedBy", fields: [addedById], references: [id])

  services    BoardService[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

// Услуга, оказанная клиенту в конкретном месяце, с выручкой по ней.
model BoardService {
  id            String         @id @default(cuid())

  boardClientId String
  boardClient   BoardClient    @relation(fields: [boardClientId], references: [id], onDelete: Cascade)

  title         String

  // Первое число месяца, к которому относится услуга. Дата, а не пара
  // чисел «год и месяц»: режим произвольного периода сравнивает диапазоны,
  // и с датой это обычное сравнение, а не арифметика в запросе.
  month         DateTime

  // День, когда клиент заплатил за эту услугу. Месяц выше остаётся основой
  // расчётов — на вопрос «считать выручку по дате оплаты?» заказчик ответил
  // «как сейчас». Дата нужна рядом с суммой: по месяцу не видно, пришли
  // деньги первого числа или тридцатого.
  //
  // Необязательное в базе, обязательное в форме: у заведённых до этой
  // правки услуг даты нет, их заказчик проставит руками.
  paidAt        DateTime?

  revenueCents  Int

  expenses      BoardExpense[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([boardClientId, month])
  @@index([month])
}

// Расход по услуге. Их бывает несколько на одну услугу, и у каждого своё
// назначение: «копирайтер», «дизайнер», «подписка».
model BoardExpense {
  id          String       @id @default(cuid())

  serviceId   String
  service     BoardService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  title       String
  amountCents Int

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([serviceId])
}

// ---------------------------------------------------------------------------
// Мотивация сотрудников
// ---------------------------------------------------------------------------
//
// Устройство в двух словах. У каждого сотрудника на месяц есть личный банк
// премии и баллы. Баллы определяют, какую долю банка он заберёт, и какой у
// него уровень работы. За что дают и снимают баллы, решает профиль его
// должности: у дизайнера одни события, у разработчика другие.
//
// Главное правило хранения: текущих «баллов» и «банка» в базе нет. Есть два
// журнала, банка и событий, и всё остальное считается по ним. Так любую
// цифру на экране можно разложить на записи, из которых она получилась, и
// ни одна правка не теряется: записи не удаляются, а отменяются.

// Как фиксируется событие: руками руководителя или само, по задачам CRM.
enum MotivationEventMode {
  manual
  auto
}

// Какое именно автоматическое правило стоит за событием. Задачи из Иерархии
// и личные разделены: личные человек ставит себе сам, поэтому за них баллов
// меньше и есть дневной потолок, а просроченную личную задачу ночная уборка
// CRM удаляет, так что штраф за неё бывает только один раз.
enum MotivationAutoRule {
  task_on_time
  personal_task_on_time
  task_overdue
  personal_task_overdue
}

// Запись журнала банка: стартовая сумма месяца, пополнение или списание.
enum MotivationBankKind {
  start
  top_up
  write_off
}

// Почему пополнили банк. Три варианта — ровно те, что в форме из задания.
enum MotivationBankReason {
  new_client
  free_budget
  other
}

// Чем является запись журнала событий: событием из профиля, ручной
// корректировкой на произвольное число баллов или покупкой клиентом нового
// продукта. Последнее вынесено отдельно, потому что у него своя форма и своя
// кнопка, и в истории оно должно узнаваться с первого взгляда.
enum MotivationEntryKind {
  event
  adjustment
  product
}

// Профиль должности: набор условий, по которым человек получает и теряет
// баллы. Один сотрудник — один профиль.
model MotivationProfile {
  id    String @id @default(cuid())
  title String @unique

  // Сколько лежит в банке первого числа, ещё до всех пополнений. По умолчанию
  // ноль: банк растёт только тогда, когда приходят клиенты и бюджет.
  startBankCents Int @default(0)

  // Своя шкала премии вместо общей. Сами уровни лежат в MotivationPrizeLevel
  // с этим profileId, пока флаг снят, они просто не используются.
  customScale Boolean @default(false)

  // Свои подсказки к уровням работы. Ключ — номер уровня (position), значение
  // — текст. Чего здесь нет, берётся из общих уровней.
  workHints Json @default("{}")

  // Дата, которую сотрудник видит в «Моих условиях»: «Условия обновлены 1
  // ноября». Отдельно от updatedAt, потому что переименование профиля
  // условий не меняет, а правка баллов меняет.
  conditionsUpdatedAt DateTime @default(now())

  eventTypes  MotivationEventType[]
  prizeLevels MotivationPrizeLevel[]
  assignments MotivationAssignment[]
  events      MotivationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Событие в профиле: за что и сколько баллов.
model MotivationEventType {
  id String @id @default(cuid())

  profileId String
  profile   MotivationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title String

  // Короткий пример для «Моих условий», чтобы человек понимал, о чём речь.
  example String?

  // Баллы в шкалу премии и в шкалу уровня работы. По умолчанию одинаковые,
  // но админ может развести их, если событие должно влиять на шкалы
  // по-разному. Знак входит в число: штраф — отрицательные баллы.
  prizePoints Int
  levelPoints Int

  mode MotivationEventMode @default(manual)

  // Заполнено только у автоматических событий. В одном профиле одно правило
  // встречается не больше одного раза, иначе задача давала бы баллы дважды.
  autoRule MotivationAutoRule?

  // Служебная метка события, которое есть во всех профилях и на которое
  // ссылается отдельная кнопка. Сейчас такое одно: «клиент купил продукт».
  systemKey String?

  enabled  Boolean @default(true)
  position Int     @default(0)

  events MotivationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, autoRule])
  @@unique([profileId, systemKey])
  @@index([profileId, position])
}

// Уровень шкалы премии: сколько баллов нужно и какую долю банка он даёт.
// profileId пустой — это общая шкала, заполненный — своя шкала профиля.
// Шкала всегда сохраняется целиком, поэтому номер уровня не уникален на
// уровне базы: старые строки удаляются и пишутся новые в одной транзакции.
model MotivationPrizeLevel {
  id String @id @default(cuid())

  profileId String?
  profile   MotivationProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  position  Int
  threshold Int

  // Доля банка в процентах. У последнего уровня всегда 100: он и есть весь
  // банк, так прямо сказано в задании.
  percent Int

  @@index([profileId, position])
}

// Уровень работы: текстовая оценка месяца без денег.
model MotivationWorkLevel {
  id       String @id @default(cuid())
  position Int    @unique
  title    String

  // Нижняя граница в баллах. Верхняя — это граница следующего уровня минус
  // один, отдельно её не храним, чтобы между уровнями не возникло дыр.
  minPoints Int
  hint      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Общие настройки мотивации. Строка ровно одна, с id «global».
model MotivationSettings {
  id String @id @default("global")

  // Штраф за просрочку одной задачи не больше этого числа баллов, сколько
  // бы дней она ни висела.
  overduePenaltyCap Int @default(10)

  // Сколько баллов в день можно получить за личные задачи. Личную задачу
  // человек ставит себе сам, без потолка ими можно было бы набрать всю шкалу.
  personalTaskDailyCap Int @default(2)

  // Слать ли сотруднику сообщения о пополнении банка и о баллах. Шлёт их
  // агент, вкладка здесь только хранит выбор админа.
  notifyBank   Boolean @default(true)
  notifyPoints Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// Какой профиль у сотрудника и с какого момента. Записи не перезаписываются:
// перевели на другую должность — появилась новая строка, а старые события
// так и остались посчитаны по прежним условиям.
model MotivationAssignment {
  id String @id @default(cuid())

  userId String
  user   User   @relation("MotivationAssignmentUser", fields: [userId], references: [id])

  profileId String
  profile   MotivationProfile @relation(fields: [profileId], references: [id])

  from DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("MotivationAssignmentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, from])
}

// Журнал банка. Банк сотрудника за месяц — это сумма его записей за месяц.
model MotivationBankEntry {
  id String @id @default(cuid())

  userId String
  user   User   @relation("MotivationBankEntryUser", fields: [userId], references: [id])

  kind   MotivationBankKind
  reason MotivationBankReason?

  // Плюс у пополнения и стартовой суммы, минус у списания.
  amountCents Int

  // Клиент, за которого пополнили банк. Название копируется сюда же: клиента
  // могут переименовать или удалить, а история должна читаться как была.
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName String?

  comment String?

  // Момент, к которому относится запись. По нему определяется месяц и
  // порядок, в котором банк рос вперемешку с баллами.
  occurredAt DateTime @default(now())

  // Защита от повторов. У стартовой суммы здесь «start:сотрудник:месяц» —
  // второй раз за месяц она не положится. У пополнения — «request:ключ
  // формы:сотрудник»: двойное нажатие «Пополнить» или повтор запроса после
  // обрыва связи не положат деньги дважды. У остальных пусто, а пустые
  // значения уникальность не нарушают.
  dedupeKey String? @unique

  // Кто сделал запись. Пусто у стартовой суммы — её кладёт сама система.
  createdById String?
  createdBy   User?   @relation("MotivationBankEntryCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, occurredAt])
}

// Журнал событий: всё, за что сотрудник получил или потерял баллы.
model MotivationEvent {
  id String @id @default(cuid())

  userId String
  user   User   @relation("MotivationEventUser", fields: [userId], references: [id])

  // Профиль, по которому событие посчитано в момент начисления. Если
  // человека потом перевели, его прошлое остаётся по старым условиям.
  profileId String?
  profile   MotivationProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  eventTypeId String?
  eventType   MotivationEventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)

  kind MotivationEntryKind
  mode MotivationEventMode

  // Название и баллы копируются в момент начисления. Админ может потом
  // поменять событие в профиле, но уже начисленное от этого не меняется.
  title       String
  prizePoints Int
  levelPoints Int

  // Задачу держим без внешнего ключа: личные задачи ночная уборка CRM
  // удаляет, а запись о баллах за неё должна остаться.
  taskId    String?
  taskTitle String?

  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName String?

  comment    String?
  occurredAt DateTime @default(now())

  // Защита от повторов. У автоматики — «задача:правило:день»: одна задача не
  // получит баллы за срок дважды, даже если её закрыть, открыть и закрыть. У
  // ручных баллов — «request:ключ формы:сотрудник»: двойное нажатие кнопки не
  // начислит их дважды.
  dedupeKey String? @unique

  // Пусто у автоматических событий.
  createdById String?
  createdBy   User?   @relation("MotivationEventCreatedBy", fields: [createdById], references: [id])

  // Отмена вместо удаления: запись остаётся в истории, баллы пересчитываются.
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("MotivationEventCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  createdAt DateTime @default(now())

  @@index([userId, occurredAt])
}

// Что сотрудник уже видел во вкладке. До агента это единственный способ
// сказать человеку «тебе пополнили банк»: новое подсвечивается, пока он
// его не открыл.
model MotivationSeen {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id])
  bankSeenAt   DateTime?
  eventsSeenAt DateTime?
  updatedAt    DateTime  @updatedAt
}
