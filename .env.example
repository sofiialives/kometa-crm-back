# Пример настроек. Скопируйте в .env и заполните.
# Сам .env в репозиторий не попадает — там боевые ключи.

# --- Сервер и база ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kometa_crm?schema=public
CLIENT_URL=http://localhost:5173

# --- Вход ---
# В разработке можно не задавать: подставятся временные значения.
# На сервере (NODE_ENV=production) обязательны: без них сервер не запустится.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_CLIENT_ID=

# --- Первый админ (npm run seed:admin) ---
# Пароль обязателен, значения по умолчанию нет. Придумайте свой
# и смените его после первого входа.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Бот напоминаний ---
# Без токена бот просто не запускается, остальной сервер работает как обычно.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=kometa_agent_bot
# Только для проверки на поддельном телеграме (src/scripts/fakeTelegram.js):
# TELEGRAM_API_BASE=http://localhost:4900/bot
REMIND_BEFORE_MIN=15

# --- Хранилище файлов Архива (Cloudflare R2) ---
# Берётся в панели Cloudflare: R2 -> Overview. Account ID виден там же,
# ключи выдаются один раз при создании токена.
# Пока не заполнено, Архив работает на чтение, а загрузка отвечает
# понятной ошибкой вместо падения.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kometa-archive
# Потолок на один отчёт в байтах. По умолчанию 20 МБ.
MAX_REPORT_BYTES=20971520

# --- Почта для восстановления пароля ---
# Без SMTP письма печатаются в консоль — этого хватает для разработки.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KOMETA CRM <no-reply@kometa.web3>
